---
layout: base.njk
permalink: contact.html
nav_active: contact
eleventyComputed:
  title: "{{ pages.contact.meta.title | safe }}"
  description: "{{ pages.contact.meta.description | safe }}"
canonical: "https://rosemaryestheticsidaho.com/contact.html"
og_image: "https://rosemaryestheticsidaho.com/img/hero-facial.webp"
og_image_width: 1600
og_image_height: 2131
---
<section class="pagehero">
  <div class="wrap">
    <div class="eyebrow">{{ pages.contact.hero.eyebrow | safe }}</div>
    <h1>{{ pages.contact.hero.heading | safe }}</h1>
    <p class="lead editable">{{ pages.contact.hero.lead | safe }}</p>
  </div>
</section>
<section class="svcs reveal" style="padding-top:44px">
  <div class="wrap">
    <div class="grid3">
      <div class="vp"><h3>{{ pages.contact.cards.call.heading | safe }}</h3><p style="margin-bottom:16px">{{ pages.contact.cards.call.body | safe }}</p><a href="tel:{{ site.contact.phone_e164 }}" class="btn ghost" style="width:100%">{{ site.contact.phone_display }}</a></div>
      <div class="vp"><h3>{{ pages.contact.cards.email.heading | safe }}</h3><p style="margin-bottom:16px">{{ pages.contact.cards.email.body | safe }}</p><a href="mailto:{{ site.contact.email }}" class="btn ghost" style="width:100%;text-transform:none;letter-spacing:.02em">{{ site.contact.email }}</a></div>
      <div class="vp"><h3>{{ pages.contact.cards.book.heading | safe }}</h3><p style="margin-bottom:16px">{{ pages.contact.cards.book.body | safe }}</p><a href="{{ site.contact.booking_url }}" target="_blank" rel="noopener" class="btn rose" style="width:100%">{{ pages.contact.cards.book.cta | safe }}</a></div>
    </div>
    <div class="split" style="margin-top:56px;align-items:start">
      <div>
        <div class="eyebrow">{{ pages.contact.message.eyebrow | safe }}</div>
        <h2 style="margin-top:6px">{{ pages.contact.message.heading | safe }}</h2>
        <form class="cf" name="contact" method="POST" data-netlify="true" data-netlify-honeypot="bot-field" id="contactForm">
          <input type="hidden" name="form-name" value="contact">
          <p hidden><label>Leave this field empty: <input name="bot-field"></label></p>
          <label for="cf-name">{{ pages.contact.message.label_name | safe }} <span class="req" aria-hidden="true">*</span></label>
          <input type="text" id="cf-name" name="name" required autocomplete="name">
          <label for="cf-email">{{ pages.contact.message.label_email | safe }} <span class="req" aria-hidden="true">*</span></label>
          <input type="email" id="cf-email" name="email" required autocomplete="email">
          <label for="cf-phone">{{ pages.contact.message.label_phone | safe }}</label>
          <input type="tel" id="cf-phone" name="phone" autocomplete="tel">
          <label for="cf-message">{{ pages.contact.message.label_message | safe }} <span class="req" aria-hidden="true">*</span></label>
          <textarea id="cf-message" name="message" required></textarea>
          <button type="submit" class="btn rose" style="margin-top:20px">{{ pages.contact.message.submit | safe }}</button>
          <p id="formResult" role="status" aria-live="polite"></p>
        </form>
      </div>
      <div>
        <div class="eyebrow">{{ pages.contact.visit.eyebrow | safe }}</div>
        <h2 style="margin-top:6px">{{ site.address.street }}</h2>
        <p style="color:var(--fg-soft);margin:0 0 18px">{{ site.address.city }}, {{ site.address.region }} {{ site.address.postal_code }} &middot; {{ pages.contact.visit.parking_note | safe }}</p>
        <div class="mapframe"><iframe src="https://www.google.com/maps?q=1096+S+Boulevard,+Idaho+Falls,+ID+83402&output=embed" title="{{ pages.contact.visit.map_title | replace('"', '&quot;') | safe }}" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe></div>
        <p style="margin-top:18px"><a href="https://www.google.com/maps/dir/?api=1&destination=1096+S+Boulevard,+Idaho+Falls,+ID+83402" target="_blank" rel="noopener" class="btn solid" data-tooltip="{{ pages.contact.visit.directions_tooltip | replace('"', '&quot;') | safe }}">{{ pages.contact.visit.directions_cta | safe }}</a></p>
        <div class="eyebrow" style="margin-top:34px">{{ pages.contact.visit.hours.eyebrow | safe }}</div>
        <div class="plist" style="margin-top:12px">
          <div class="price-row"><span>{{ pages.contact.visit.hours.monday_label | safe }}</span><span class="pr">{{ site.hours.monday }}</span></div>
          <div class="price-row"><span>{{ pages.contact.visit.hours.tuesday_label | safe }}</span><span class="pr">{{ site.hours.tuesday }}</span></div>
          <div class="price-row"><span>{{ pages.contact.visit.hours.wednesday_label | safe }}</span><span class="pr">{{ site.hours.wednesday }}</span></div>
          <div class="price-row"><span>{{ pages.contact.visit.hours.thursday_label | safe }}</span><span class="pr">{{ site.hours.thursday }}</span></div>
          <div class="price-row"><span>{{ pages.contact.visit.hours.friday_label | safe }}</span><span class="pr">{{ site.hours.friday }}</span></div>
          <div class="price-row"><span>{{ pages.contact.visit.hours.saturday_label | safe }}</span><span class="pr">{{ site.hours.saturday }}</span></div>
          <div class="price-row"><span>{{ pages.contact.visit.hours.sunday_label | safe }}</span><span class="pr">{{ site.hours.sunday }}</span></div>
        </div>
        <p class="notice">{{ pages.contact.visit.notice | safe }}</p>
      </div>
    </div>
  </div>
</section>
<script>
(function(){
  var f=document.getElementById('contactForm');if(!f)return;
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var r=document.getElementById('formResult');r.textContent={{ pages.contact.form_feedback.sending | jsString | safe }};
    var data=new FormData(f);
    var enc=new URLSearchParams(data).toString();
    fetch('/',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:enc})
      .then(function(res){
        if(res.ok){r.textContent={{ pages.contact.form_feedback.success | jsString | safe }};f.reset();}
        else{r.textContent={{ pages.contact.form_feedback.error | replace("{{PHONE}}", site.contact.phone_display) | jsString | safe }};}
      })
      .catch(function(){r.textContent={{ pages.contact.form_feedback.error | replace("{{PHONE}}", site.contact.phone_display) | jsString | safe }};});
  });
})();
</script>

{% include "book-cta.njk" %}
