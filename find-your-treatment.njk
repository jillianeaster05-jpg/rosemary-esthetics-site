---
layout: base.njk
permalink: find-your-treatment.html
nav_active: find-your-treatment
eleventyComputed:
  title: "{{ pages.find_your_treatment.meta.title | safe }}"
  description: "{{ pages.find_your_treatment.meta.description | safe }}"
canonical: "https://rosemaryestheticsidaho.com/find-your-treatment.html"
og_image: "https://rosemaryestheticsidaho.com/img/glow-portrait.webp"
og_image_width: 1100
og_image_height: 1466
---
<section class="pagehero">
  <div class="wrap">
    <div class="eyebrow">{{ pages.find_your_treatment.hero.eyebrow | safe }}</div>
    <h1>{{ pages.find_your_treatment.hero.heading | safe }}</h1>
    <p class="lead editable">{{ pages.find_your_treatment.hero.lead | safe }}</p>
  </div>
</section>
<section class="svcs reveal" style="padding-top:44px">
  <div class="wrap quiz" style="max-width:760px">
    <form id="quizForm" novalidate>
      <fieldset>
        <legend><span class="qnum">{{ pages.find_your_treatment.quiz.questions[0].qnum | safe }}</span>{{ pages.find_your_treatment.quiz.questions[0].prompt | safe }}</legend>
        <div class="opts">
          <label class="opt"><input type="radio" name="goal" value="clear" required><span>{{ pages.find_your_treatment.quiz.questions[0].options[0] | safe }}</span></label>
          <label class="opt"><input type="radio" name="goal" value="relax"><span>{{ pages.find_your_treatment.quiz.questions[0].options[1] | safe }}</span></label>
          <label class="opt"><input type="radio" name="goal" value="define"><span>{{ pages.find_your_treatment.quiz.questions[0].options[2] | safe }}</span></label>
          <label class="opt"><input type="radio" name="goal" value="event"><span>{{ pages.find_your_treatment.quiz.questions[0].options[3] | safe }}</span></label>
        </div>
      </fieldset>
      <fieldset>
        <legend><span class="qnum">{{ pages.find_your_treatment.quiz.questions[1].qnum | safe }}</span>{{ pages.find_your_treatment.quiz.questions[1].prompt | safe }}</legend>
        <div class="opts">
          <label class="opt"><input type="radio" name="area" value="face" required><span>{{ pages.find_your_treatment.quiz.questions[1].options[0] | safe }}</span></label>
          <label class="opt"><input type="radio" name="area" value="eyes"><span>{{ pages.find_your_treatment.quiz.questions[1].options[1] | safe }}</span></label>
          <label class="opt"><input type="radio" name="area" value="back"><span>{{ pages.find_your_treatment.quiz.questions[1].options[2] | safe }}</span></label>
          <label class="opt"><input type="radio" name="area" value="smooth"><span>{{ pages.find_your_treatment.quiz.questions[1].options[3] | safe }}</span></label>
        </div>
      </fieldset>
      <fieldset>
        <legend><span class="qnum">{{ pages.find_your_treatment.quiz.questions[2].qnum | safe }}</span>{{ pages.find_your_treatment.quiz.questions[2].prompt | safe }}</legend>
        <div class="opts">
          <label class="opt"><input type="radio" name="time" value="short" required><span>{{ pages.find_your_treatment.quiz.questions[2].options[0] | safe }}</span></label>
          <label class="opt"><input type="radio" name="time" value="medium"><span>{{ pages.find_your_treatment.quiz.questions[2].options[1] | safe }}</span></label>
          <label class="opt"><input type="radio" name="time" value="long"><span>{{ pages.find_your_treatment.quiz.questions[2].options[2] | safe }}</span></label>
        </div>
      </fieldset>
      <div class="center"><button type="submit" class="btn rose">{{ pages.find_your_treatment.quiz.button_label | safe }}</button>
      <p id="quizError" role="alert" style="color:var(--rose-deep);font-size:14px;margin-top:14px"></p></div>
    </form>
    <div id="quizResult" class="reveal" hidden>
      <div class="reco">
        <div class="eyebrow">{{ pages.find_your_treatment.quiz.result_card.eyebrow | safe }}</div>
        <h2 id="recoName"></h2>
        <div class="pd" id="recoPrice"></div>
        <p class="why" id="recoWhy"></p>
        <div class="cta">
          <a href="{{ site.contact.booking_url }}" target="_blank" rel="noopener" class="btn rose">{{ pages.find_your_treatment.quiz.result_card.book_cta | safe }}</a>
          <a id="recoLink" href="services.html" class="btn ghost">{{ pages.find_your_treatment.quiz.result_card.learn_more | safe }}</a>
        </div>
        <p style="font-size:13px;color:var(--fg-soft);margin-top:20px">{{ pages.find_your_treatment.quiz.result_card.compare_label | safe }}<a href="services.html" style="color:var(--rose-deep);border-bottom:1px solid var(--rose)">{{ pages.find_your_treatment.quiz.result_card.compare_link | safe }}</a>{{ pages.find_your_treatment.quiz.result_card.compare_middle | safe }}<a href="javascript:location.reload()" style="color:var(--rose-deep);border-bottom:1px solid var(--rose)">{{ pages.find_your_treatment.quiz.result_card.retake_link | safe }}</a>.</p>
      </div>
    </div>
  </div>
</section>
<script>
(function(){
  var f=document.getElementById('quizForm');
  function pick(n){var el=f.querySelector('input[name="'+n+'"]:checked');return el?el.value:null}
  f.addEventListener('submit',function(e){
    e.preventDefault();
    var g=pick('goal'),a=pick('area'),t=pick('time'),err=document.getElementById('quizError');
    if(!g||!a||!t){err.textContent='{{ pages.find_your_treatment.quiz.error_message | safe }}';return}
    err.textContent='';
    var R;
    if(a==='back'){
      R=(g==='clear')?['{{ pages.find_your_treatment.quiz.results.back_clear.name | safe }}','{{ pages.find_your_treatment.quiz.results.back_clear.price_time | safe }}','{{ pages.find_your_treatment.quiz.results.back_clear.why | safe }}','services-back.html']
                     :['{{ pages.find_your_treatment.quiz.results.back_relax.name | safe }}','{{ pages.find_your_treatment.quiz.results.back_relax.price_time | safe }}','{{ pages.find_your_treatment.quiz.results.back_relax.why | safe }}','services-back.html'];
    } else if(a==='smooth'){
      R=['{{ pages.find_your_treatment.quiz.results.smooth.name | safe }}','{{ pages.find_your_treatment.quiz.results.smooth.price_time | safe }}','{{ pages.find_your_treatment.quiz.results.smooth.why | safe }}','services-waxing.html'];
    } else if(a==='eyes'||g==='define'){
      R=(t==='long')?['{{ pages.find_your_treatment.quiz.results.eyes_long.name | safe }}','{{ pages.find_your_treatment.quiz.results.eyes_long.price_time | safe }}','{{ pages.find_your_treatment.quiz.results.eyes_long.why | safe }}','services-brows.html']
        :(t==='short')?['{{ pages.find_your_treatment.quiz.results.eyes_short.name | safe }}','{{ pages.find_your_treatment.quiz.results.eyes_short.price_time | safe }}','{{ pages.find_your_treatment.quiz.results.eyes_short.why | safe }}','services-lashes.html']
        :['{{ pages.find_your_treatment.quiz.results.eyes_medium.name | safe }}','{{ pages.find_your_treatment.quiz.results.eyes_medium.price_time | safe }}','{{ pages.find_your_treatment.quiz.results.eyes_medium.why | safe }}','services-lashes.html'];
    } else if(g==='event'){
      R=(t==='long')?['{{ pages.find_your_treatment.quiz.results.event_long.name | safe }}','{{ pages.find_your_treatment.quiz.results.event_long.price_time | safe }}','{{ pages.find_your_treatment.quiz.results.event_long.why | safe }}','services-facials.html']
        :(t==='short')?['{{ pages.find_your_treatment.quiz.results.event_short.name | safe }}','{{ pages.find_your_treatment.quiz.results.event_short.price_time | safe }}','{{ pages.find_your_treatment.quiz.results.event_short.why | safe }}','services-facials.html']
        :['{{ pages.find_your_treatment.quiz.results.event_medium.name | safe }}','{{ pages.find_your_treatment.quiz.results.event_medium.price_time | safe }}','{{ pages.find_your_treatment.quiz.results.event_medium.why | safe }}','services-facials.html'];
    } else {
      R=(t==='short')?['{{ pages.find_your_treatment.quiz.results.default_short.name | safe }}','{{ pages.find_your_treatment.quiz.results.default_short.price_time | safe }}','{{ pages.find_your_treatment.quiz.results.default_short.why | safe }}','services-facials.html']
        :(t==='long')?((g==='relax')?['{{ pages.find_your_treatment.quiz.results.default_long_relax.name | safe }}','{{ pages.find_your_treatment.quiz.results.default_long_relax.price_time | safe }}','{{ pages.find_your_treatment.quiz.results.default_long_relax.why | safe }}','services-facials.html']
                                    :['{{ pages.find_your_treatment.quiz.results.default_long_other.name | safe }}','{{ pages.find_your_treatment.quiz.results.default_long_other.price_time | safe }}','{{ pages.find_your_treatment.quiz.results.default_long_other.why | safe }}','services-facials.html'])
        :['{{ pages.find_your_treatment.quiz.results.default_medium.name | safe }}','{{ pages.find_your_treatment.quiz.results.default_medium.price_time | safe }}','{{ pages.find_your_treatment.quiz.results.default_medium.why | safe }}','services-facials.html'];
    }
    var extra=(g==='clear')?'{{ pages.find_your_treatment.quiz.extra_clear_goal | safe }}':'';
    document.getElementById('recoName').innerHTML=R[0];
    document.getElementById('recoPrice').innerHTML=R[1];
    document.getElementById('recoWhy').innerHTML=R[2]+extra;
    document.getElementById('recoLink').setAttribute('href',R[3]);
    f.hidden=true;
    var res=document.getElementById('quizResult');res.hidden=false;
    res.scrollIntoView({behavior:'smooth',block:'center'});
  });
})();
</script>

{% include "book-cta.njk" %}
