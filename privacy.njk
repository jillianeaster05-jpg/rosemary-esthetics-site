---
layout: base.njk
permalink: privacy.html
nav_active: privacy
eleventyComputed:
  title: "{{ pages.privacy.meta.title | safe }}"
  description: "{{ pages.privacy.meta.description | safe }}"
canonical: "https://rosemaryestheticsidaho.com/privacy.html"
og_image: "https://rosemaryestheticsidaho.com/img/hero-facial.webp"
og_image_width: 1600
og_image_height: 2131
---
<section class="pagehero">
  <div class="wrap">
    <div class="eyebrow">{{ pages.privacy.hero.eyebrow | safe }}</div>
    <h1>{{ pages.privacy.hero.heading | safe }}</h1>
    <p class="lead editable">{{ pages.privacy.hero.body | safe }}</p>
  </div>
</section>
<section class="svcs reveal" style="padding-top:44px">
  <div class="wrap" style="max-width:780px">
    <div class="polsec"><h2>{{ pages.privacy.collect.heading | safe }}</h2>
      <p class="editable">{{ pages.privacy.collect.body | safe }}</p></div>
    <div class="polsec"><h2>{{ pages.privacy.booking.heading | safe }}</h2>
      <p class="editable">{{ pages.privacy.booking.intro | safe }}<a href="https://squareup.com/us/en/legal/general/privacy" target="_blank" rel="noopener" style="color:var(--rose-deep);border-bottom:1px solid var(--rose)">{{ pages.privacy.booking.link_text | safe }}</a>{{ pages.privacy.booking.outro | safe }}</p></div>
    <div class="polsec"><h2>{{ pages.privacy.cookies.heading | safe }}</h2>
      <p class="editable">{{ pages.privacy.cookies.body | safe }}</p></div>
    <div class="polsec"><h2>{{ pages.privacy.choices.heading | safe }}</h2>
      <p class="editable">{{ pages.privacy.choices.intro | safe }}<a href="mailto:{{ site.contact.email }}" style="color:var(--rose-deep)">{{ site.contact.email }}</a>{{ pages.privacy.choices.mid | safe }}<a href="tel:{{ site.contact.phone_e164 }}" style="color:var(--rose-deep)">{{ site.contact.phone_display }}</a>{{ pages.privacy.choices.outro | safe }}</p></div>
    <p style="font-size:13.5px;color:var(--fg-soft)">{{ pages.privacy.effective_date_line | safe }} &middot; {{ site.business.name }}, {{ site.address.street }}, {{ site.address.city }}, {{ site.address.region }} {{ site.address.postal_code }}</p>
  </div>
</section>
