---
layout: base.njk
permalink: services.html
nav_active: services
eleventyComputed:
  title: "{{ pages.services.meta.title | safe }}"
  description: "{{ pages.services.meta.description | safe }}"
canonical: "https://rosemaryestheticsidaho.com/services.html"
og_image: "https://rosemaryestheticsidaho.com/img/facial-mask.webp"
og_image_width: 1100
og_image_height: 1466
---
<section class="pagehero">
  <div class="wrap">
    <div class="eyebrow">{{ pages.services.hero.eyebrow | safe }}</div>
    <h1>{{ pages.services.hero.heading | safe }}</h1>
    <p class="lead editable">{{ pages.services.hero.lead_before | safe }}{{ site.policies.deposit_pct }}{{ pages.services.hero.lead_after | safe }}</p>
    <div class="cta" style="margin-top:26px;display:flex;gap:13px;justify-content:center;flex-wrap:wrap"><a href="{{ site.contact.booking_url }}" target="_blank" rel="noopener" class="btn rose">{{ pages.services.hero.cta_book | safe }}</a><a href="find-your-treatment.html" class="btn ghost">{{ pages.services.hero.cta_find | safe }}</a></div>
  </div>
</section>
<section class="svcs reveal" style="padding-top:50px">
  <div class="wrap" style="max-width:820px">

    <div style="margin-bottom:44px">
      <h2 style="font-size:clamp(27px,3.6vw,38px);margin:0 0 4px">{{ pages.services.services.facials.heading | safe }}</h2>
      <p class="editable" style="color:var(--fg-soft);margin:0 0 16px;font-size:15.5px">{{ pages.services.services.facials.body | safe }}</p>
      <div class="plist"><div class="price-row"><span>{{ site.services.facials[0].name }}</span><span class="pr"><b>{{ site.services.facials[0].price }}</b> &middot; {{ site.services.facials[0].duration }}</span></div><div class="price-row"><span>{{ site.services.facials[1].name }}</span><span class="pr"><b>{{ site.services.facials[1].price }}</b> &middot; {{ site.services.facials[1].duration }}</span></div><div class="price-row"><span>{{ site.services.facials[2].name }}</span><span class="pr"><b>{{ site.services.facials[2].price }}</b> &middot; {{ site.services.facials[2].duration }}</span></div><div class="price-row"><span>{{ site.services.facials[3].name }}</span><span class="pr"><b>{{ site.services.facials[3].price }}</b> &middot; {{ site.services.facials[3].duration }}</span></div></div>
      <p style="margin-top:14px"><a class="more" style="font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;font-weight:500;color:var(--rose-deep)" href="services-facials.html">{{ pages.services.services.more_text | safe }}</a></p>
    </div>

    <div style="margin-bottom:44px">
      <h2 style="font-size:clamp(27px,3.6vw,38px);margin:0 0 4px">{{ pages.services.services.lashes.heading | safe }}</h2>
      <p class="editable" style="color:var(--fg-soft);margin:0 0 16px;font-size:15.5px">{{ pages.services.services.lashes.body | safe }}</p>
      <div class="plist">{% for s in site.services.lashes %}<div class="price-row"><span>{{ s.name }}</span><span class="pr"><b>{{ s.price }}</b>{% if s.duration %} &middot; {{ s.duration }}{% endif %}</span></div>{% endfor %}</div>
      <p style="margin-top:14px"><a class="more" style="font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;font-weight:500;color:var(--rose-deep)" href="services-lashes.html">{{ pages.services.services.more_text | safe }}</a></p>
    </div>

    <div style="margin-bottom:44px">
      <h2 style="font-size:clamp(27px,3.6vw,38px);margin:0 0 4px">{{ pages.services.services.brows.heading | safe }}</h2>
      <p class="editable" style="color:var(--fg-soft);margin:0 0 16px;font-size:15.5px">{{ pages.services.services.brows.body | safe }}</p>
      <div class="plist">{% for s in site.services.brows %}<div class="price-row"><span>{{ s.name }}</span><span class="pr"><b>{{ s.price }}</b>{% if s.duration %} &middot; {{ s.duration }}{% endif %}</span></div>{% endfor %}</div>
      <p style="margin-top:14px"><a class="more" style="font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;font-weight:500;color:var(--rose-deep)" href="services-brows.html">{{ pages.services.services.more_text | safe }}</a></p>
    </div>

    <div style="margin-bottom:44px">
      <h2 style="font-size:clamp(27px,3.6vw,38px);margin:0 0 4px">{{ pages.services.services.waxing.heading | safe }}</h2>
      <p class="editable" style="color:var(--fg-soft);margin:0 0 16px;font-size:15.5px">{{ pages.services.services.waxing.body | safe }}</p>
      <div class="plist">{% for s in site.services.waxing %}<div class="price-row"><span>{{ s.name }}</span><span class="pr"><b>{{ s.price }}</b>{% if s.duration %} &middot; {{ s.duration }}{% endif %}</span></div>{% endfor %}</div>
      <p style="margin-top:14px"><a class="more" style="font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;font-weight:500;color:var(--rose-deep)" href="services-waxing.html">{{ pages.services.services.more_text | safe }}</a></p>
    </div>

    <div style="margin-bottom:44px">
      <h2 style="font-size:clamp(27px,3.6vw,38px);margin:0 0 4px">{{ pages.services.services.back.heading | safe }}</h2>
      <p class="editable" style="color:var(--fg-soft);margin:0 0 16px;font-size:15.5px">{{ pages.services.services.back.body | safe }}</p>
      <div class="plist">{% for s in site.services.back %}<div class="price-row"><span>{{ s.name }}</span><span class="pr"><b>{{ s.price }}</b>{% if s.duration %} &middot; {{ s.duration }}{% endif %}</span></div>{% endfor %}</div>
      <p style="margin-top:14px"><a class="more" style="font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;font-weight:500;color:var(--rose-deep)" href="services-back.html">{{ pages.services.services.more_text | safe }}</a></p>
    </div>

    <div style="margin-bottom:44px">
      <h2 style="font-size:clamp(27px,3.6vw,38px);margin:0 0 4px"><span class="tag new">{{ pages.services.services.led.tag | safe }}</span> {{ pages.services.services.led.heading | safe }}</h2>
      <p class="editable" style="color:var(--fg-soft);margin:0 0 16px;font-size:15.5px">{{ pages.services.services.led.body | safe }}</p>
      <div class="plist">{% for s in site.services.led %}<div class="price-row"><span>{{ s.name }}</span><span class="pr"><b>{{ s.price }}</b>{% if s.duration %} &middot; {{ s.duration }}{% endif %}</span></div>{% endfor %}</div>
      <p style="margin-top:14px"><a class="more" style="font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;font-weight:500;color:var(--rose-deep)" href="services-led.html">{{ pages.services.services.more_text | safe }}</a></p>
    </div>

    <div style="margin-bottom:44px">
      <h2 style="font-size:clamp(27px,3.6vw,38px);margin:0 0 4px">{{ pages.services.services.addons.heading | safe }}</h2>
      <p class="editable" style="color:var(--fg-soft);margin:0 0 16px;font-size:15.5px">{{ pages.services.services.addons.body | safe }}</p>
      <div class="plist">{% for s in site.services.addons %}<div class="price-row"><span>{{ s.name }}</span><span class="pr"><b>{{ s.price }}</b>{% if s.duration %} &middot; {{ s.duration }}{% endif %}</span></div>{% endfor %}</div>
      <p style="margin-top:14px"><a class="more" style="font-size:11.5px;letter-spacing:.18em;text-transform:uppercase;font-weight:500;color:var(--rose-deep)" href="services-facials.html">{{ pages.services.services.more_text | safe }}</a></p>
    </div>
  </div>
</section>

{% include "book-cta.njk" %}
