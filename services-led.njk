---
layout: base.njk
permalink: services-led.html
nav_active: services
eleventyComputed:
  title: "{{ pages.services_led.meta.title | safe }}"
  description: "{{ pages.services_led.meta.description | safe }}"
canonical: "https://rosemaryestheticsidaho.com/services-led.html"
og_image: "https://rosemaryestheticsidaho.com/img/glow-portrait.webp"
og_image_width: 1100
og_image_height: 1466
---
<section class="pagehero">
  <div class="wrap">
    <p class="crumb"><a href="services.html">{{ pages.services_led.hero.crumb_label | safe }}</a> &nbsp;/&nbsp; {{ pages.services_led.hero.crumb_current | safe }}</p>
    <div style="margin-bottom:10px"><span class="tag new">{{ pages.services_led.hero.tag_new | safe }}</span></div>
    <h1>{{ pages.services_led.hero.heading | safe }}</h1>
    <p class="lead editable">{{ pages.services_led.hero.lead | safe }}</p>
    <div style="margin-top:26px"><a href="{{ site.contact.booking_url }}" target="_blank" rel="noopener" class="btn rose">{{ pages.services_led.hero.cta | safe }}</a></div>
  </div>
</section>
<section class="svcs reveal" style="padding-top:46px">
  <div class="wrap split rev" style="align-items:start">
    <div>
      <div class="eyebrow">{{ pages.services_led.pricing.eyebrow | safe }}</div>
      <h2 style="margin-top:6px">{{ pages.services_led.pricing.heading | safe }}</h2>
      <div class="plist">{% for s in site.services.led %}<div class="price-row"><span>{{ s.name }}</span><span class="pr"><b>{{ s.price }}</b>{% if s.duration %} &middot; {{ s.duration }}{% endif %}</span></div>{% endfor %}</div>
      <div class="eyebrow" style="margin-top:38px">{{ pages.services_led.good_to_know.eyebrow | safe }}</div>
      <ul class="goodlist editable">{% for item in pages.services_led.good_to_know.items %}<li>{{ item.text | replace("{{PRICE}}", site.services.led[0].price) | safe }}</li>{% endfor %}</ul>

    </div>
    <div class="frame portrait" style="position:sticky;top:100px"><img src="img/glow-portrait.webp" alt="Client with calm, glowing skin after a treatment at Rosemary Esthetics" width="1100" height="1466" loading="lazy"></div>
  </div>
</section>
<section class="reveal">
  <div class="wrap" style="max-width:760px">
    <div class="sec-head"><div class="eyebrow">{{ pages.services_led.visit.eyebrow | safe }}</div><h2>{{ pages.services_led.visit.heading | safe }}</h2></div>
    <ol class="steps editable">{% for step in pages.services_led.visit.steps %}<li><b>{{ step.title | safe }}</b><p>{{ step.body | safe }}</p></li>{% endfor %}</ol>
    <div class="center" style="margin-top:26px"><a href="{{ site.contact.booking_url }}" target="_blank" rel="noopener" class="btn solid">{{ pages.services_led.visit.cta | safe }}</a></div>
    <p class="center" style="font-size:14px;color:var(--fg-soft);margin-top:24px">{{ pages.services_led.visit.explore_label | safe }}<a href="services-facials.html" style="color:var(--rose-deep);border-bottom:1px solid var(--rose)">{{ pages.services_led.visit.explore_links.facials | safe }}</a> &middot; <a href="services-back.html" style="color:var(--rose-deep);border-bottom:1px solid var(--rose)">{{ pages.services_led.visit.explore_links.back | safe }}</a> &middot; <a href="services-brows.html" style="color:var(--rose-deep);border-bottom:1px solid var(--rose)">{{ pages.services_led.visit.explore_links.brows | safe }}</a></p>
  </div>
</section>

{% include "book-cta.njk" %}
