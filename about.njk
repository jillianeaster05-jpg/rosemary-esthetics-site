---
layout: base.njk
permalink: about.html
nav_active: about
eleventyComputed:
  title: "{{ pages.about.meta.title | safe }}"
  description: "{{ pages.about.meta.description | safe }}"
canonical: "https://rosemaryestheticsidaho.com/about.html"
og_image: "https://rosemaryestheticsidaho.com/img/jillian-portrait.webp"
og_image_width: 533
og_image_height: 1286
---
<section class="pagehero">
  <div class="wrap">
    <div class="eyebrow">{{ pages.about.hero.eyebrow | safe }}</div>
    <h1>{{ pages.about.hero.heading | safe }}</h1>
    <p class="lead editable">{{ pages.about.hero.lead | safe }}</p>
  </div>
</section>
<section class="svcs reveal" style="padding-top:44px">
  <div class="wrap split">
    <div class="frame portrait sq"><img src="img/jillian-portrait.webp" alt="{{ pages.about.story.image_alt | replace('"', '&quot;') | safe }}" width="533" height="1286" loading="eager"></div>
    <div>
      <div class="eyebrow">{{ pages.about.story.eyebrow | safe }}</div>
      <h2>{{ pages.about.story.heading | safe }}</h2>
      <p class="editable">{{ pages.about.story.para1 | safe }}</p>
      <p class="editable">{{ pages.about.story.para2 | safe }}</p>
      <p class="editable">{{ pages.about.story.para3 | safe }}</p>
      <p class="editable">{{ pages.about.story.para4 | safe }}</p>
      <div class="sign" aria-hidden="true">{{ pages.about.story.signature | safe }}</div>
    </div>
  </div>
</section>
<section class="reveal">
  <div class="wrap split rev">
    <div>
      <div class="eyebrow">{{ pages.about.credentials.eyebrow | safe }}</div>
      <h2>{{ pages.about.credentials.heading | safe }}</h2>
      <ul class="goodlist editable">
{% for item in pages.about.credentials.items %}        <li>{{ item | safe }}</li>
{% endfor %}      </ul>
    </div>
    <div class="frame portrait"><img src="img/glow-portrait.webp" alt="{{ pages.about.credentials.image_alt | replace('"', '&quot;') | safe }}" width="1100" height="1466" loading="lazy"></div>
  </div>
</section>
<section class="svcs reveal">
  <div class="wrap" style="max-width:760px">
    <div class="sec-head"><div class="eyebrow">{{ pages.about.studio.eyebrow | safe }}</div><h2>{{ pages.about.studio.heading | safe }}</h2><p class="editable">{{ pages.about.studio.intro_before | safe }}{{ site.address.street }}{{ pages.about.studio.intro_after | safe }}</p></div>
    <div class="grid3 two">
      <div class="vp"><h3>{{ pages.about.studio.vp1_heading | safe }}</h3><p class="editable">{{ pages.about.studio.vp1_body | safe }}</p></div>
      <div class="vp"><h3>{{ pages.about.studio.vp2_heading | safe }}</h3><p class="editable">{{ pages.about.studio.vp2_body | safe }}</p></div>
    </div>
    <div class="center" style="margin-top:34px"><a href="{{ site.contact.booking_url }}" target="_blank" rel="noopener" class="btn rose">{{ pages.about.studio.cta | safe }}</a></div>
  </div>
</section>

{% include "book-cta.njk" %}
