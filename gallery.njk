---
layout: base.njk
permalink: gallery.html
nav_active: gallery
eleventyComputed:
  title: "{{ pages.gallery.meta.title | safe }}"
  description: "{{ pages.gallery.meta.description | safe }}"
canonical: "https://rosemaryestheticsidaho.com/gallery.html"
og_image: "https://rosemaryestheticsidaho.com/img/lash-lift-1.webp"
og_image_width: 1100
og_image_height: 1466
---
<section class="pagehero">
  <div class="wrap">
    <div class="eyebrow">{{ pages.gallery.hero.eyebrow | safe }}</div>
    <h1>{{ pages.gallery.hero.heading | safe }}</h1>
    <p class="lead editable">{{ pages.gallery.hero.lead_before | safe }}<a href="{{ site.social.instagram }}" target="_blank" rel="noopener" style="color:var(--rose-deep);border-bottom:1px solid var(--rose)">{{ pages.gallery.hero.lead_link_text | safe }}</a>{{ pages.gallery.hero.lead_after | safe }}</p>
  </div>
</section>
<section class="svcs reveal" style="padding-top:44px">
  <div class="wrap">
    <div class="gal-grid">
{% for t in pages.gallery.tiles %}      <figure class="gcard"><div class="frame"><img src="{{ t.src }}" alt="{{ t.alt | safe }}" width="{{ t.width }}" height="{{ t.height }}" loading="lazy"></div><figcaption class="editable">{{ t.caption | safe }}</figcaption></figure>
{% endfor %}    </div>
    <div class="center" style="margin-top:40px"><a href="{{ site.contact.booking_url }}" target="_blank" rel="noopener" class="btn rose">{{ pages.gallery.cta | safe }}</a></div>
  </div>
</section>

{% include "book-cta.njk" %}
