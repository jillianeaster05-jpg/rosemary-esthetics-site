<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<script>document.documentElement.classList.add('js-anim')</script>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="canonical" href="{{ canonical }}">
<meta property="og:site_name" content="{{ site.business.name }}">
<meta property="og:title" content="{{ og_title or title }}">
<meta property="og:description" content="{{ og_description or description }}">
<meta property="og:type" content="{{ og_type or 'website' }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ og_image }}">
<meta property="og:image:width" content="{{ og_image_width }}">
<meta property="og:image:height" content="{{ og_image_height }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title or title }}">
<meta name="twitter:description" content="{{ og_description or description }}">
<meta name="twitter:image" content="{{ og_image }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Montserrat:wght@300;400;500;600&family=Pinyon+Script&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/site.css">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png">
<link rel="mask-icon" href="/favicon.svg" color="#B27A77">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#B27A77">
<script type="application/ld+json">{{ beautysalon | dump | safe }}</script>
{% if extra_jsonld %}<script type="application/ld+json">{{ extra_jsonld | dump | safe }}</script>{% endif %}
</head>
<body>
<a class="skip" href="#main">{{ pages.shared.nav.skip_text | safe }}</a>
<header class="site">
  <div class="wrap nav">
    <a href="index.html" class="brandlk" aria-label="{{ site.business.name }} home"><img src="img/logo-header.png" alt="{{ site.business.name }}" width="1600" height="179" fetchpriority="high" style="width:auto;display:block"></a>
    <button class="navtoggle" aria-expanded="false" aria-controls="mainnav" onclick="var n=document.getElementById('mainnav');var o=n.classList.toggle('open');this.setAttribute('aria-expanded',o)"><svg viewBox="0 0 16 12" aria-hidden="true"><path d="M0 1h16M0 6h16M0 11h16" stroke="currentColor" stroke-width="1.6"/></svg>{{ pages.shared.nav.menu_text | safe }}</button>
    <nav class="navlinks" id="mainnav" aria-label="Main">
      <a href="index.html"{% if nav_active == 'home' %} aria-current="page"{% endif %}>{{ pages.shared.nav.home | safe }}</a>
      <a href="services.html"{% if nav_active == 'services' %} aria-current="page"{% endif %}>{{ pages.shared.nav.services | safe }}</a>
      <a href="gallery.html"{% if nav_active == 'gallery' %} aria-current="page"{% endif %}>{{ pages.shared.nav.gallery | safe }}</a>
      <a href="about.html"{% if nav_active == 'about' %} aria-current="page"{% endif %}>{{ pages.shared.nav.about | safe }}</a>
      <a href="policies-faq.html"{% if nav_active == 'policies' %} aria-current="page"{% endif %}>{{ pages.shared.nav.policies | safe }}</a>
      <a href="contact.html"{% if nav_active == 'contact' %} aria-current="page"{% endif %}>{{ pages.shared.nav.contact | safe }}</a>
      <a href="{{ site.contact.booking_url }}" target="_blank" rel="noopener" class="btn rose" data-tooltip="Secure booking through Square, opens in a new tab" data-tip="bottom">{{ pages.shared.nav.book_now | safe }}</a>
    </nav>
  </div>
</header>
<main id="main">
{{ content | safe }}
</main>
<footer class="site">
  <div class="wrap">
    <div class="vine"><svg viewBox="0 0 150 15" width="100%" height="15" xmlns="http://www.w3.org/2000/svg" style="overflow:visible" aria-hidden="true"><path d="M 6 12.5 C 45 2.5, 105 2.5, 144 7.5" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/><path d="M 13.9 10.7 Q 13.7 13.8 15.8 17.0" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/><path d="M 21.5 9.2 Q 23.3 5.9 23.5 2.6" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/><path d="M 29.4 8.0 Q 29.2 11.1 31.3 14.3" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/><path d="M 37.7 6.9 Q 39.5 3.6 39.7 0.3" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/><path d="M 46.1 6.0 Q 45.9 9.1 48.0 12.3" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/><path d="M 54.8 5.3 Q 56.6 2.0 56.8 -1.3" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/><path d="M 63.6 4.8 Q 63.4 7.9 65.5 11.1" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/><path d="M 72.4 4.4 Q 74.2 1.1 74.4 -2.2" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/><path d="M 81.3 4.3 Q 81.1 7.4 83.2 10.6" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/><path d="M 90.1 4.2 Q 91.9 0.9 92.1 -2.4" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/><path d="M 98.8 4.3 Q 98.6 7.4 100.7 10.6" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/><path d="M 107.4 4.6 Q 109.2 1.3 109.4 -2.0" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/><path d="M 115.8 5.0 Q 115.6 8.1 117.7 11.3" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/><path d="M 123.9 5.5 Q 125.7 2.2 125.9 -1.1" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/><path d="M 131.7 6.2 Q 131.5 9.3 133.6 12.5" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/><path d="M 144 7.5 q 5 -3 9 -1.5" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/><path d="M 144 7.5 q 5 3 9 1.5" fill="none" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/></svg></div>
    <div class="nm">{{ site.business.name }}</div>
    <div class="tagl">{{ site.business.tagline }}</div>
    <nav class="fnav" aria-label="Footer"><a href="index.html">{{ pages.shared.nav.home | safe }}</a><a href="services.html">{{ pages.shared.nav.services | safe }}</a><a href="gallery.html">{{ pages.shared.nav.gallery | safe }}</a><a href="about.html">{{ pages.shared.nav.about | safe }}</a><a href="reviews.html">{{ pages.shared.footer.reviews | safe }}</a><a href="find-your-treatment.html">{{ pages.shared.footer.find_your_treatment | safe }}</a><a href="policies-faq.html">{{ pages.shared.footer.policies_faq | safe }}</a><a href="contact.html">{{ pages.shared.nav.contact | safe }}</a><a href="privacy.html">{{ pages.shared.footer.privacy | safe }}</a><a href="{{ site.contact.booking_url }}" target="_blank" rel="noopener">{{ pages.shared.nav.book_now | safe }}</a></nav>
    <div class="meta">{{ site.address.street }}, {{ site.address.city }}, {{ site.address.region }} {{ site.address.postal_code }} &middot; <a href="tel:{{ site.contact.phone_e164 }}">{{ site.contact.phone_display }}</a> ({{ site.contact.phone_note }}) &middot; <a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a><br>{{ site.hours.display }}<br><a href="{{ site.social.instagram }}" target="_blank" rel="noopener">{{ pages.shared.footer.instagram | safe }}</a> &middot; <a href="{{ site.social.tiktok }}" target="_blank" rel="noopener">{{ pages.shared.footer.tiktok | safe }}</a> &middot; <a href="{{ site.social.facebook }}" target="_blank" rel="noopener">{{ pages.shared.footer.facebook | safe }}</a></div>
    <div class="copy">&copy; {{ pages.shared.footer.copyright_year | safe }} {{ site.business.name }} &middot; {{ site.business.owner_name }}, {{ site.business.owner_title }} &middot; {{ site.address.city }}, {{ pages.shared.footer.copyright_state | safe }}</div>
  </div>
</footer>
<div class="mobilebar"><a href="tel:{{ site.contact.phone_e164 }}">{{ pages.shared.mobile_bar.call_text | safe }}</a><a href="{{ site.contact.booking_url }}" target="_blank" rel="noopener">{{ pages.shared.nav.book_now | safe }}</a></div>
<script>
(function(){
  var els=[].slice.call(document.querySelectorAll('.reveal'));
  if(!els.length)return;
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if(reduce||!('IntersectionObserver' in window)){els.forEach(function(e){e.classList.add('is-in')});return;}
  var io=new IntersectionObserver(function(ents){
    ents.forEach(function(en){if(en.isIntersecting){en.target.classList.add('is-in');io.unobserve(en.target);}});
  },{threshold:0.12,rootMargin:'0px 0px -8% 0px'});
  els.forEach(function(e){io.observe(e)});
  // safety net: never leave content hidden if the observer misses (slow layout, edge cases)
  setTimeout(function(){els.forEach(function(e){e.classList.add('is-in')});},1600);
})();
(function(){
  // image skeleton / ghost loaders: clear the shimmer once each framed image loads
  [].slice.call(document.querySelectorAll('.frame')).forEach(function(f){
    var img=f.querySelector('img');
    if(!img){f.classList.add('img-loaded');return;}
    var done=function(){f.classList.add('img-loaded');};
    if(img.complete && img.naturalWidth>0){done();}
    else{img.addEventListener('load',done);img.addEventListener('error',done);}
  });
})();
</script>
</body>
</html>
