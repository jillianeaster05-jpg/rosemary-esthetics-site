><path d="M 224.4 18.4 Q 224.1 23.1 227.2 27.9" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/><path d="M 238.7 18.6 Q 241.4 13.6 241.7 8.7" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/><path d="M 252.9 18.8 Q 252.6 23.4 255.8 28.2" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/><path d="M 267.0 19.1 Q 269.7 14.1 270.0 9.2" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/><path d="M 280.8 19.5 Q 280.5 24.1 283.6 28.9" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/><path d="M 294.4 19.9 Q 297.1 15.0 297.4 10.0" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/><path d="M 307.7 20.5 Q 307.4 25.1 310.6 29.9" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/><path d="M 320.8 21.1 Q 323.5 16.2 323.8 11.2" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/><path d="M 352 23 q 7 -4 12 -2" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/><path d="M 352 23 q 7 4 12 2" fill="none" stroke="currentColor" stroke-width="1.1" stroke-linecap="round"/></svg></div>
    <div class="eyebrow">{{ book_eyebrow or "Currently Accepting New Clients" }}</div>
    <h2>Book Your Appointment</h2>
    <p style="color:var(--fg-soft);max-width:500px;margin:6px auto 0">Online booking through Square. Pick your service, choose a time, and you're set. A {{ site.policies.deposit_pct }} deposit holds your spot and goes toward your service.</p>
    <div class="info">
      <div><b>Location</b>{{ site.address.street }}<br>{{ site.address.city }}, {{ site.address.region }} {{ site.address.postal_code }}</div>
      <div><b>Hours</b>{{ site.hours.display }}</div>
      <div><b>Contact</b><a href="tel:{{ site.contact.phone_e164 }}">{{ site.contact.phone_display }}</a> ({{ site.contact.phone_note }})<br><a href="mailto:{{ site.contact.email }}">{{ site.contact.email }}</a></div>
    </div>
    <a href="{{ site.contact.booking_url }}" target="_blank" rel="noopener" class="btn solid">Book Online</a>
    <p class="notice">Please note: {{ site.announcement.closure_notice }}</p>
  </div>
</section>
