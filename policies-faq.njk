layout: base.njk
permalink: policies-faq.html
nav_active: policies
eleventyComputed:
  title: "{{ pages.policies_faq.meta.title | safe }}"
  description: "{{ pages.policies_faq.meta.description | safe }}"
canonical: "https://rosemaryestheticsidaho.com/policies-faq.html"
