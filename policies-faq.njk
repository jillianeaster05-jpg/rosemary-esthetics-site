---
<section class="pagehero">
  <div class="wrap">
    <div class="eyebrow">{{ pages.policies_faq.hero.eyebrow | safe }}</div>
    <h1>{{ pages.policies_faq.hero.heading | safe }}</h1>
    <p class="lead editable">{{ pages.policies_faq.hero.body | safe }}</p>
  </div>
</section>
<section class="svcs reveal" style="padding-top:44px">
  <div class="wrap" style="max-width:780px">
    <div class="polsec"><h2>{{ pages.policies_faq.deposits.heading | safe }}</h2>
      <p class="editable">{{ pages.policies_faq.deposits.intro | safe }}<b>{{ site.policies.deposit_pct }} {{ pages.policies_faq.deposits.unit_word | safe }}</b>{{ pages.policies_faq.deposits.outro | safe }}</p></div>
    <div class="polsec"><h2>{{ pages.policies_faq.cancellations.heading | safe }}</h2>
      <p class="editable">{{ pages.policies_faq.cancellations.intro | safe }}<b>{{ site.policies.cancellation_notice }}{{ pages.policies_faq.cancellations.unit_word | safe }}</b>{{ pages.policies_faq.cancellations.outro | safe }}</p>
      <ul class="editable">
        <li>{{ pages.policies_faq.cancellations.fee_short_label | safe }}: <b>{{ site.policies.fee_short_notice }}</b>{{ pages.policies_faq.cancellations.fee_suffix | safe }}</li>
        <li>{{ pages.policies_faq.cancellations.fee_same_day_label | safe }}: <b>{{ site.policies.fee_same_day }}</b>{{ pages.policies_faq.cancellations.fee_suffix | safe }}</li>
        <li>{{ pages.policies_faq.cancellations.fee_no_show_label | safe }}: <b>{{ site.policies.fee_no_show }}</b>{{ pages.policies_faq.cancellations.fee_suffix | safe }}</li>
      </ul></div>
    <!-- ===== DRAFT: Refunds section - PENDING JILLIAN APPROVAL. Do NOT publish until approved. To go live: remove this comment wrapper (the opening line above and the END line below). Approval doc: "12 - Reports & Handoffs/Rosemary-Refund-Cancellation-Policy-DRAFT.md"
    <div class="polsec"><h2>Refunds</h2>
      <p class="editable">Your <b>{{ site.policies.deposit_pct }} deposit</b> is non-refundable, but it is never wasted as long as you give at least 24 hours' notice: it moves with you to your rescheduled appointment and still goes toward your service. If you cancel with less than 24 hours' notice, cancel same-day, or do not show, the deposit is kept and the cancellation fee above applies.</p>
      <p class="editable">Because every service is personalized and performed in the moment, completed services are not refundable. Your happiness still matters to us: if something does not feel right, reach out within 7 days and we will make it right, whether that is an adjustment or a plan for your next visit.</p></div>
    ===== END DRAFT Refunds ===== -->
    <div class="polsec"><h2>{{ pages.policies_faq.late_arrivals.heading | safe }}</h2>
      <p class="editable">{{ pages.policies_faq.late_arrivals.body | safe }}</p></div>
    <div class="polsec"><h2>{{ pages.policies_faq.minors.heading | safe }}</h2>
      <p class="editable">{{ pages.policies_faq.minors.body | safe }}</p></div>
    <div class="polsec"><h2>{{ pages.policies_faq.health_safety.heading | safe }}</h2>
      <p class="editable">{{ pages.policies_faq.health_safety.body | safe }}</p></div>
    <div class="polsec"><h2>{{ pages.policies_faq.payments.heading | safe }}</h2>
      <p class="editable">{{ pages.policies_faq.payments.intro | safe }}{{ site.payments }}{{ pages.policies_faq.payments.outro | safe }}</p></div>
    <div class="polsec"><h2>{{ pages.policies_faq.upcoming_closures.heading | safe }}</h2>
      <p class="editable">{{ pages.policies_faq.upcoming_closures.body | safe }}</p></div>
    <p style="font-size:14.5px;color:var(--fg-soft);font-style:italic">{{ pages.policies_faq.contact_line.intro | safe }}<a href="tel:{{ site.contact.phone_e164 }}" style="color:var(--rose-deep)">{{ site.contact.phone_display }}</a>{{ pages.policies_faq.contact_line.mid | safe }}<a href="mailto:{{ site.contact.email }}" style="color:var(--rose-deep)">{{ site.contact.email }}</a>{{ pages.policies_faq.contact_line.outro | safe }}</p>
  </div>
</section>
<section class="reveal">
  <div class="wrap" style="max-width:780px">
    <div class="sec-head"><div class="eyebrow">{{ pages.policies_faq.faq.eyebrow | safe }}</div><h2>{{ pages.policies_faq.faq.heading | safe }}</h2></div>
    {% for item in pages.policies_faq.faq.items %}<details class="faq"><summary>{{ item.question | safe }}</summary><div class="ans editable">{{ item.answer | safe }}</div></details>{% endfor %}
  </div>
</section>

