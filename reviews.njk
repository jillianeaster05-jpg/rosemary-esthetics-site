---
layout: base.njk
permalink: reviews.html
nav_active: reviews
eleventyComputed:
  title: "{{ pages.reviews.meta.title | safe }}"
  description: "{{ pages.reviews.meta.description | safe }}"
canonical: "https://rosemaryestheticsidaho.com/reviews.html"
og_image: "https://rosemaryestheticsidaho.com/img/hero-facial.webp"
og_image_width: 1600
og_image_height: 2131
book_eyebrow: "Be One of the First"
---
<section class="pagehero">
  <div class="wrap">
    <div class="eyebrow">{{ pages.reviews.hero.eyebrow | safe }}</div>
    <h1>{{ pages.reviews.hero.heading | safe }}</h1>
    <p class="lead editable">{{ pages.reviews.hero.lead | safe }}</p>
    <p style="margin-top:22px"><a href="{{ site.social.google_review }}" target="_blank" rel="noopener" class="btn">{{ pages.reviews.hero.cta | safe }}</a></p>
  </div>
</section>
<section class="svcs reveal" style="padding-top:40px">
  <div class="wrap" style="max-width:760px">
    <div class="grid3 two">
      <div class="vp"><h3>{{ pages.reviews.card1.heading | safe }}</h3><p class="editable">{{ pages.reviews.card1.body_a | safe }}<a href="{{ site.social.google_review }}" target="_blank" rel="noopener" style="color:var(--rose-deep)">{{ pages.reviews.card1.link_text | safe }}</a>{{ pages.reviews.card1.body_b | safe }}<a href="tel:{{ site.contact.phone_e164 }}" style="color:var(--rose-deep)">{{ site.contact.phone_display }}</a>{{ pages.reviews.card1.body_c | safe }}<a href="mailto:{{ site.contact.email }}" style="color:var(--rose-deep)">{{ site.contact.email }}</a>{{ pages.reviews.card1.body_d | safe }}</p></div>
      <div class="vp"><h3>{{ pages.reviews.card2.heading | safe }}</h3><p class="editable">{{ pages.reviews.card2.body_a | safe }}<a href="{{ site.social.instagram }}" target="_blank" rel="noopener" style="color:var(--rose-deep)">{{ pages.reviews.card2.link_a_text | safe }}</a>{{ pages.reviews.card2.body_b | safe }}<a href="{{ site.social.tiktok }}" target="_blank" rel="noopener" style="color:var(--rose-deep)">{{ pages.reviews.card2.link_b_text | safe }}</a>{{ pages.reviews.card2.body_c | safe }}</p></div>
    </div>
  </div>
</section>
<section class="dark reveal">
  <div class="wrap">
    <div class="eyebrow">{{ pages.reviews.social.eyebrow | safe }}</div>
    <h2>{{ pages.reviews.social.heading | safe }}</h2>
    <p class="editable">{{ pages.reviews.social.body | safe }}</p>
    <p style="margin-top:24px"><a href="{{ site.social.instagram }}" target="_blank" rel="noopener" class="btn">{{ pages.reviews.social.cta | safe }}</a></p>
  </div>
</section>

{% include "book-cta.njk" %}
